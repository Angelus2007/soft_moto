{
  "name": "softmoto-backend",
  "version": "1.1.0",
  "private": true,
  "description": "Serveur Soft Moto : conducteurs, paiements et contrats. Base PostgreSQL (SQLite en local si DATABASE_URL est absente).",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "verifier-db": "node verifier-db.js",
    "migrer": "node migrer-vers-postgres.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.13.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
