# Copiez ce fichier en « .env » puis lancez :  npm run start:env   (Node 20.6 ou plus)
# Sur un hébergeur (Railway, Render, …), saisissez plutôt ces variables dans son tableau de bord.

# --- Base de données PostgreSQL (si absente : SQLite dans le fichier softmoto.db) ---
DATABASE_URL=postgresql://softmoto:motdepasse@localhost:5432/softmoto
# Mettre true si l'hébergeur de la base l'exige (Neon, Supabase, Railway, Render…)
DATABASE_SSL=false

# --- Serveur ---
PORT=3000
NODE_ENV=production
FUSEAU=Africa/Porto-Novo

# --- Premier administrateur (créé seulement si aucun administrateur n'existe) ---
ADMIN_EMAIL=admin@softmoto.bj
ADMIN_PASSWORD=changez-moi-tout-de-suite

# --- Divers ---
VERSEMENT_JOURNALIER=3500
# SEED_DEMO=1 ajoute 10 conducteurs de démonstration dans une base PostgreSQL vide (déconseillé en production)
